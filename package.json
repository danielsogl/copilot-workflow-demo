{
  "name": "copilot-workflow-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"ng serve\" \"npm run start:api\" \"npx tsx copilot-server.ts\"",
    "start:api": "dotnet run --project backend/TaskApi",
    "review-bot": "npx tsx review-bot.ts",
    "build": "ng build",
    "build:api": "dotnet build backend/Backend.slnx",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "dotnet test backend/Backend.slnx",
    "test:e2e": "bddgen && playwright test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@github/copilot-sdk": "^1.0.8",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/language-server": "^22.0.8",
    "@angular/language-service": "^22.0.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@playwright/test": "^1.62.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "angular-eslint": "^22.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.0",
    "lefthook": "^2.1.10",
    "ng-mocks": "^14.15.3",
    "playwright": "^1.62.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/core": "22"
    }
  }
}

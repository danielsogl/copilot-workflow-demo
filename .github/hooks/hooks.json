{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"$(git rev-parse --show-toplevel)/scripts/hooks/session-context.sh\"",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "\"$(git rev-parse --show-toplevel)/scripts/hooks/guard-destructive-bash.sh\"",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"$(git rev-parse --show-toplevel)/scripts/hooks/format-changed-files.sh\"",
        "timeoutSec": 30
      }
    ]
  }
}

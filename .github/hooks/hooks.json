{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/session-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "preToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/guard-destructive-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/format-changed-files.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "version": 1
}

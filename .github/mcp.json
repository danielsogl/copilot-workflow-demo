{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp/oauth",
      "tools": [
        "*"
      ],
      "id": ""
    },
    "angular-cli": {
      "type": "local",
      "tools": [
        "*"
      ],
      "id": "",
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli",
        "mcp"
      ]
    },
    "playwright-test": {
      "type": "local",
      "tools": [
        "*"
      ],
      "id": "",
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ]
    },
    "codegraph": {
      "type": "local",
      "tools": [
        "*"
      ],
      "id": "",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}